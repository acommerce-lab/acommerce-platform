@page "/{slug}/notifications"
@page "/{slug}/r/{role}/notifications"
@*
    SSR صَرِف — لا @@rendermode. السَّبَب: InteractiveServerRenderMode
    يَستَدعي OnInitializedAsync مَرَّتَين (SSR ثُمَّ circuit boot)، وَفي
    الـ circuit الثاني HttpContext = null فَلا يُحَمَّل Auth، فَيَظهَر
    "تَحتاج تَسجيل" رَغم وُجود cookie صالِح. الـ live updates تَصِل عَبر
    nav badge JS العامّ في App.razor (SignalR + polling).
*@
@inject IDocumentStore Store
@inject AuthSession Auth
@inject IHttpContextAccessor HttpCtx
@using ACommerce.Kit.Notifications

<div class="acs-page">
@if (!_authed)
{
    <AcEmptyState IconName="bell"
                  Title="الإشعارات تَحتاج تَسجيل دُخول"
                  Message="سَجِّل دُخولك لِتَلَقّي تَنبيهات لَحظيّة."
                  ActionLabel="تَسجيل دُخول"
                  ActionHref="@AuthSession.LinkFor(Slug, Role, $"login?returnUrl=/{Slug}/notifications")" />
}
else
{
    <h1 class="acm-wizard-title" style="margin:0;">الإشعارات</h1>

    @* بَنر تَفعيل إشعارات Push — يَظهَر فَقَط إذا الإذن لَم يُمنَح بَعد. *@
    <div id="ac-push-banner" style="display:none;" class="ac-card">
        <div style="display:flex;align-items:center;gap:12px;padding:8px;">
            <span style="font-size:24px;">🔔</span>
            <div style="flex:1;">
                <strong>فَعِّل إشعارات الجَوّال</strong>
                <small style="display:block;color:var(--ac-text-muted);">
                    اِستَلِم تَنبيهات لِلرَسائِل وَالعُروض حَتَّى وَالتَّطبيق مُغلَق.
                </small>
            </div>
            <button type="button" class="ac-btn ac-btn-primary ac-btn-sm"
                    onclick="acEnableNotifications().then(ok => {
                        if (ok) document.getElementById('ac-push-banner').style.display='none';
                    });">
                تَفعيل
            </button>
        </div>
    </div>
    <script>
        (function () {
            if (!('Notification' in window) || !('serviceWorker' in navigator)) return;
            if (Notification.permission === 'default') {
                var b = document.getElementById('ac-push-banner');
                if (b) b.style.display = 'block';
            }
        })();
    </script>

    @if (_items is null)         { <AcLoadingState Message="جارٍ التَحميل…" /> }
    else if (_items.Count == 0)  { <AcEmptyState Title="لا توجَد إشعارات" IconName="bell" /> }
    else
    {
        <div style="display:flex;flex-direction:column;gap:8px;">
            @foreach (var n in _items)
            {
                <AcCard Class="@(n.IsRead ? "" : "ac-card-unread")">
                    <ChildContent>
                        <div style="display:flex;justify-content:space-between;align-items:start;gap:8px;">
                            <strong>@n.Title</strong>
                            <span class="ac-muted" style="font-size:11px;">@n.At.ToString("HH:mm")</span>
                        </div>
                        <p style="margin:6px 0 0;color:var(--ac-text-muted);font-size:14px;">@n.Body</p>
                        @if (!string.IsNullOrEmpty(n.RelatedUrl))
                        {
                            <a href="@n.RelatedUrl" style="display:inline-block;margin-top:8px;
                                                           color:var(--ac-primary);font-size:13px;">
                                فَتح →
                            </a>
                        }
                    </ChildContent>
                </AcCard>
            }
        </div>
    }
}
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    bool _authed;
    Guid _userId;
    List<Notification>? _items;

    protected override async Task OnInitializedAsync()
    {
        if (HttpCtx.HttpContext is { } ctx)
        {
            Auth.SetTenant(Slug);
            Auth.Load(ctx, Slug);
        }
        _authed = Auth.IsAuthenticated;
        if (!_authed) return;
        _userId = Auth.UserId!.Value;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        await using var s = Store.QuerySession(Slug);
        _items = (await s.Query<Notification>()
            .Where(n => n.UserId == _userId)
            .OrderByDescending(n => n.At).Take(50).ToListAsync()).ToList();

        // عَلِّم كُلّ الغَير-مَقروء كَ مَقروء عِندَ فَتح الصَفحَة — يُصَفِّر
        // الـ badge في الـ nav. الكِتابَة منفصلة عن الـ Read فَوقُ.
        var unread = _items.Where(n => !n.IsRead).ToList();
        if (unread.Count > 0)
        {
            await using var ws = Store.LightweightSession(Slug);
            foreach (var n in unread)
            {
                n.IsRead = true;
                ws.Store(n);
            }
            await ws.SaveChangesAsync();
        }
    }
}
