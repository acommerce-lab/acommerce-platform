@page "/studio"
@page "/studio/ideas"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Incubator.FeasibilityAnalysisService Incubator
@inject Marten.IDocumentStore Store
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator
@using ACommerce.Kit.Tenants

@*
    لوحَة رائِد الأَعمال — مَدخَل مَوَحَّد:
    ١) تَطبيقاتي (المَتاجِر الَّتي يَملِكها) — كَ "اشتِراك مَتجَر تَطبيقات".
    ٢) أَفكاري وتَحاليلي (الـ incubator sessions).
    ٣) إجراءات سَريعَة: فِكرَة جَديدَة، تَطبيق جَديد.

    الـ Active يَتَبَدَّل بَين home/ideas حَسَب المَسار.
*@

<StudioShell Title="@Title" Active="@(IsIdeas ? "ideas" : "home")">
    <TopBarActions>
        @if (IsIdeas)
        {
            <a class="st-btn st-btn-primary" href="/studio/new">+ فِكرَة جَديدَة</a>
        }
        else
        {
            <a class="st-btn st-btn-ghost" href="/studio/new">+ فِكرَة جَديدَة</a>
            <a class="st-btn st-btn-primary" href="/admin/agent" style="margin-inline-start:8px;">+ تَطبيق جَديد</a>
        }
    </TopBarActions>
    <ChildContent>
        <div class="studio-page-head">
            <h1>@(IsIdeas ? "أَفكاري وتَحاليلي" : Greeting)</h1>
            <p>@(IsIdeas ? "كُلّ الفِكَر الَّتي طَرَحتَها وحالَة تَحليلها."
                          : "هُنا تُديرُ تَطبيقاتِكَ وتُتابِع تَحاليل أَفكارِكَ.")</p>
        </div>

        @if (!IsIdeas)
        {
            <div class="studio-stats">
                <div class="studio-stat">
                    <div class="studio-stat-label">تَطبيقاتي المُطلَقَة</div>
                    <div class="studio-stat-value">@(myApps?.Count ?? 0)</div>
                    <div class="studio-stat-sub">مَتاجِر/تَطبيقات تَملِكها</div>
                </div>
                <div class="studio-stat">
                    <div class="studio-stat-label">دِراسات مُكتَمِلَة</div>
                    <div class="studio-stat-value">@(sessions?.Count(s => s.Status == IncubatorStatus.Completed) ?? 0)</div>
                </div>
                <div class="studio-stat">
                    <div class="studio-stat-label">إجمالي الأَفكار</div>
                    <div class="studio-stat-value">@(sessions?.Count ?? 0)</div>
                </div>
            </div>

            <div class="st-section-title" style="display:flex;justify-content:space-between;align-items:center;">
                <span>تَطبيقاتي</span>
                <a href="/admin/agent" style="font-size:12px;color:var(--st-primary);text-decoration:none;font-weight:600;">+ تَطبيق جَديد</a>
            </div>
            @if (myApps is null)
            {
                <div class="st-card">جارٍ التَّحميل…</div>
            }
            else if (myApps.Count == 0)
            {
                <div class="st-card" style="text-align:center;padding:36px;">
                    <div style="font-size:42px;margin-bottom:6px;">📦</div>
                    <h3 style="margin:0 0 6px;">لا تَطبيقات بَعد</h3>
                    <p style="color:var(--st-muted);margin:0 0 16px;">حَلِّل فِكرَتَكَ أَوَّلاً، ثُمَّ أَطلِق التَّطبيق على المَنصَّة.</p>
                    <a class="st-btn st-btn-primary" href="/studio/new">ابدَأ بِفِكرَة</a>
                </div>
            }
            else
            {
                <div class="studio-list">
                    @foreach (var t in myApps)
                    {
                        <a class="studio-list-row" href="@($"/studio/apps/{t.Slug}")">
                            <span class="studio-list-icon"
                                  style="background:@(t.BrandColor)1a;color:@t.BrandColor;">
                                @(t.Name.FirstOrDefault())
                            </span>
                            <div class="studio-list-body">
                                <strong>@t.Name</strong>
                                <span>/@t.Slug · @t.Categories.Count فِئَة · @t.Roles.Count دَور</span>
                            </div>
                            <span class="st-chip">@(t.Roles.Count == 0 ? "مَتجَر" : "تَطبيق دَور-مُتَعَدِّد")</span>
                            <span style="color:var(--st-faint);">←</span>
                        </a>
                    }
                </div>
            }
        }

        <div class="st-section-title">@(IsIdeas ? "جَلَسات التَّحليل" : "آخِر الأَفكار")</div>
        @if (sessions is null)
        {
            <div class="st-card">جارٍ التَّحميل…</div>
        }
        else if (sessions.Count == 0)
        {
            <div class="st-card" style="text-align:center;padding:36px;">
                <div style="font-size:42px;margin-bottom:6px;">💡</div>
                <h3 style="margin:0 0 6px;">لا أَفكار بَعد</h3>
                <p style="color:var(--st-muted);margin:0 0 16px;">ابدَأ بِوَصف فِكرَة مَشروعِكَ لِلحُصول على دِراسَة جَدوى.</p>
                <a class="st-btn st-btn-primary" href="/studio/new">صِف فِكرَتي</a>
            </div>
        }
        else
        {
            <div class="studio-list">
                @foreach (var s in (IsIdeas ? sessions : sessions.Take(5)))
                {
                    <a class="studio-list-row" href="@($"/studio/s/{s.Id}")">
                        <span class="studio-list-icon">@StatusIcon(s.Status)</span>
                        <div class="studio-list-body">
                            <strong>@(string.IsNullOrEmpty(s.ProjectDescription)
                                ? "فِكرَة بِلا وَصف" : Truncate(s.ProjectDescription, 70))</strong>
                            <span>@StatusLabel(s.Status) · @s.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        @if (s.Status == IncubatorStatus.Completed)
                        { <span class="st-chip st-chip-success">جَودَة @s.AnalysisQualityScore%</span> }
                        else if (s.Status == IncubatorStatus.Analyzing)
                        { <span class="st-chip st-chip-warning">قَيد التَّحليل</span> }
                        else if (s.Status == IncubatorStatus.Failed)
                        { <span class="st-chip st-chip-danger">فَشِلَ</span> }
                    </a>
                }
            </div>
        }
    </ChildContent>
</StudioShell>

@code {
    List<IncubatorSession>? sessions;
    List<Tenant>? myApps;

    [Microsoft.AspNetCore.Components.Inject] NavigationManager Nav { get; set; } = default!;
    bool IsIdeas => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').EndsWith("/ideas");

    string Title => IsIdeas ? "أَفكاري وتَحاليلي" : "لوحَتي";
    string Greeting => $"أَهلاً، {Auth.UserName ?? "صاحِب المَشروع"} 👋";

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        var uid = Auth.UserId!.Value;
        sessions = await Incubator.ListForUserAsync(uid);
        await using var qs = Store.QuerySession();
        myApps = (await qs.Query<Tenant>()
            .Where(t => t.OwnerUserId == uid)
            .OrderBy(t => t.CreatedAt).ToListAsync()).ToList();
    }

    static string StatusIcon(IncubatorStatus s) => s switch
    {
        IncubatorStatus.Completed => "✅",
        IncubatorStatus.Analyzing => "⏳",
        IncubatorStatus.Failed    => "⚠️",
        IncubatorStatus.PatternSuggested => "🎯",
        _ => "✏️"
    };

    static string StatusLabel(IncubatorStatus s) => s switch
    {
        IncubatorStatus.Discovery => "قَيد الاكتِشاف",
        IncubatorStatus.PatternSuggested => "اقتُرِحَ نَمَط",
        IncubatorStatus.Analyzing => "قَيد التَّحليل",
        IncubatorStatus.Completed => "اكتَمَلَ",
        IncubatorStatus.Failed => "فَشِلَ",
        _ => "مَهجور"
    };

    static string Truncate(string s, int n) => s.Length <= n ? s : s[..n] + "…";
}
